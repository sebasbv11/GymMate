rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        return request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.keys().hasAll(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 100000;
      }
      allow read: if owner() && collection in ['routines', 'sessions'];
      allow create, update: if owner() && collection in ['routines', 'sessions'] && valid();
      allow delete: if false;
    }
  }
}
